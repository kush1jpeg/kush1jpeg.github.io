---
import { type CollectionEntry, getCollection } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import EssayPreview from "@/components/essay/EssayPreview.astro";
import Projects from "@/components/projects/Projects.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import { getAllEssays } from "@/data/getAllEssays";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

// Posts
const MAX_POSTS = 6;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

const MAX_ESSAYS = 5;
const allEssays = await getAllEssays();
const allEssaysByDate = allEssays.sort(collectionDateSort) as CollectionEntry<"essay">[];
const latestEssays = allEssaysByDate.slice(0, MAX_ESSAYS);

const MAX_PINNED_POSTS = 5;
const pinnedPosts = allPostsByDate
    .filter((p) => p.data.pinned)
    .slice(0, MAX_PINNED_POSTS);

const MAX_PROJECTS = 4;
const allProjects = await getCollection("projects");
const latestProjects = allProjects
	.sort(collectionDateSort)
	.slice(0, MAX_PROJECTS) as CollectionEntry<"projects">[];
---

<PageLayout meta={{ title: "Home" }}>
  <p class="mb-5">
  inShort. I am a 20yo CS-ug student who loves -> backend, linux, neovim, systems, philosophy. This is my personal space to document my projects, thoughts, and opinions without any restrictions. <a href="/about/" class="text-accent underline-offset-2 hover:underline">about →</a>
  </p>
  <img src="/intro.jpeg" alt="intro-bg" class=" block"/>

	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/posts/">Blogs</a></h2>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="w-full gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
            <div class="mt-8 flex justify-center">
          <a href="/posts/"
             class=" text-accent/90 hover:bg-accent rounded-md px-3 py-1 text-xs font-extralight transition-colors hover:text-white"
    >
        View All Blogs →
    </a>
</div>
	</section>
	{
		latestProjects.length > 0 && (
			<section class="mt-10">
				<h2 class="title text-global-text mb-6 text-xl">
          <a href="/projects/">Projects</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestProjects.map((projects) => (
						<li>
							<Projects projects={projects} as="h3" isPreview />
						</li>
					))}
				</ul>
        <div class="mt-8 flex justify-center">
          <a href="/projects/"
             class=" text-accent/90 hover:bg-accent rounded-md px-3 py-1 text-xs font-extralight transition-colors hover:text-white"
    >
        View All Projects →
    </a>
</div>
			</section>

    <section>
        <h2 class="mb-6 mt-8  text-sm font-semibold tracking-widest text-accent">kush1jpeg/SKILLS.md</h2>
    <div class="mb-8">
    <img
      src="https://skillicons.dev/icons?i=js,typescript,react,nodejs,mongodb,express,tailwind,arch,neovim,cpp,c,redis,docker"
      alt="Tech Stack"
    />
    </div>

      <div class="flex items-center justify-center gap-2">
      <span class="mr-5">Contact me  </span>
      <SocialList />
      </div>
    </section>

    	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/posts/">Essays</a></h2>
		<ul class="space-y-4" role="list">
			{
				latestEssays.map((p) => (
					<li class="w-full gap-1 sm:grid-cols-[auto_1fr]">
						<EssayPreview essay={p} />
					</li>
				))
			}
		</ul>
            <div class="mt-8 flex justify-center">
          <a href="/posts/"
             class=" text-accent/90 hover:bg-accent rounded-md px-3 py-1 text-xs font-extralight transition-colors hover:text-white"
    >
        View All Blogs →
    </a>
</div>
	</section>


		)
	}
</PageLayout>

