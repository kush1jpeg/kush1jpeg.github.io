---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Projects from "@/components/projects/Projects.astro";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async () => {
	const allProjects = await getCollection("projects");

	return allProjects.map((projects) => ({
		params: { slug: projects.id },
		props: { projects },
	}));
}) satisfies GetStaticPaths;

const { projects } = Astro.props;

const meta = {
	description:
		projects.data.description ||
		`Read about my project posted on: ${project.data.publishDate.toLocaleDateString()}`,
	title: projects.data.title,
};
---

<PageLayout meta={meta}>
	<Projects as="h1" projects={projects} />
</PageLayout>
