---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
---
<Tag class="group flex gap-4 py-3 border-b border-neutral-800/40 hover:bg-essay transition">

  {/* Thumbnail */}
  <div class="shrink-0">
    <Image
      src={post.data.coverImage.src}
      alt={post.data.coverImage.alt}
      class="h-14 w-20 rounded-md object-cover opacity-70 group-hover:opacity-100 transition"
    />
  </div>

  {/* Content */}
  <div class="flex flex-col min-w-0">

    {/* Title */}
    <div class="flex gap-4">
          <a
      href={`/posts/${post.id}/`}
      class="cactus-link font-semibold text-sm truncate group-hover:text-accent-2 transition"
    >
      {post.data.title}
    </a>

      <div class="flex items-center gap-2 text-xs text-muted shrink-0">
        {post.data.draft && (
          <span class="text-red-500/80 font-medium">draft</span>
        )}
        <FormattedDate date={post.data.publishDate} />
      </div>


    </div>
    {/* Description */}
      <q class="text-xs text-muted italic line-clamp-2 mt-1 opacity-70">
        {post.data.description}
      </q>

  </div>

</Tag>

